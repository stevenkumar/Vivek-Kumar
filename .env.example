# ==============================================================================
# VERCEL ENVIRONMENT VARIABLES - vivekkumar portfolio (file-based backend, no DB)
# ==============================================================================
# Add these variables to your Render service or local .env file.

# ── Frontend / Client ─────────────────────────────────────────────────────────
CLIENT_URL=https://your-production-domain.example

# ── Email notifications (Nodemailer, Gmail SMTP) ──────────────────────────────
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
EMAIL_TO=your-email@gmail.com

# ── Admin password (optional — otherwise uses backend/api/data/settings.json) ─
# Required in production. Use a long, unique password.
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
